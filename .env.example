# Firebase — copie do Console Firebase > Configurações do projeto
# Renomeie este arquivo para .env.local

VITE_FIREBASE_API_KEY=sua-api-key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Opcional — só é necessário se você habilitar o Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional — proxy CORS para a busca de capa no MangaDex (recomendado em produção).
# Cole a URL do seu Cloudflare Worker terminando em "/?url=".
# Ver cloudflare-worker/COMO_PUBLICAR.md
VITE_COVER_PROXY=https://seu-worker.workers.dev/?url=
