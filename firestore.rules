rules_version = '2';

// Cada usuário só acessa as próprias obras (lista privada por conta).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dono do documento já existente (read/update/delete).
    function isOwner() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    match /obras/{obraId} {
      allow read, delete: if isOwner();

      // Criar: precisa estar logado e gravar o próprio uid em userId.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0;

      // Atualizar: só o dono, e sem transferir a posse para outra conta.
      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId;
    }

    // Perfil mínimo do usuário — guarda o token de compartilhamento da lista.
    // Só o próprio dono lê e escreve.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Lista pública compartilhada por link.
    // - get: qualquer um com o link (o token) lê aquele documento específico.
    // - list: proibido — ninguém pode varrer a coleção / descobrir listas alheias.
    // - escrita: só o dono (ownerId == uid), inclusive na atualização ao vivo.
    match /publicLists/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Qualquer outra coleção é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
